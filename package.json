{
  "name": "firestarter-ai-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Internal Grader dashboard for Firestarter's 5-pillar AI audit tool. Stands alone from sourcehq -- own DB, own Cloro key, own deployment.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:checkers": "for f in lib/checkers/scripts/*.js; do echo \"=== $f ===\"; node \"$f\" || exit 1; done",
    "test:client-profile": "node lib/clientProfileFields.test.js",
    "test:client-intelligence": "node lib/clientIndustryIntelligence.test.js",
    "test:prompt-cadence": "node lib/promptCadenceScheduler.test.js",
    "test:prompt-topic-intelligence-pure": "node lib/promptTopicIntelligence.pure.test.js",
    "test:prompt-topic-intelligence": "node lib/promptTopicIntelligence.test.js",
    "test:opportunity-lifecycle-pure": "node lib/opportunityLifecycle.pure.test.js",
    "test:opportunity-lifecycle": "node lib/opportunityLifecycle.test.js",
    "test:verification-transition": "node lib/opportunityLifecycle.verificationTransition.test.js",
    "test:source-citation-pure": "node lib/sourceCitation.pure.test.js",
    "test:source-citation-landscape-enrichment": "node lib/sourceCitation.landscapeEnrichment.test.js",
    "test:opportunities-lifecycle-route": "node \"app/api/clients/[id]/opportunities/[opportunityId]/lifecycle/route.test.js\""
  },
  "dependencies": {
    "@fontsource/fjalla-one": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
